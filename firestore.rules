rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if true;
    }

    // Book Validation
    function isValidBook(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.author is string && data.author.size() > 0 && data.author.size() <= 200 &&
             data.status in ['available', 'loaned', 'damaged', 'lost'];
    }

    // Student Validation
    function isValidStudent(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.studentId is string && data.studentId.size() > 0;
    }

    // Loan Validation
    function isValidLoan(data) {
      return data.bookId is string && data.bookId.size() <= 128 &&
             data.studentId is string && data.studentId.size() <= 128 &&
             data.loanDate is timestamp &&
             data.dueDate is timestamp &&
             data.status in ['active', 'returned', 'overdue'];
    }

    match /books/{bookId} {
      allow read: if true;
      allow create: if isValidBook(incoming()) && bookId.size() <= 128;
      allow update: if isValidBook(incoming());
      allow delete: if true;
    }

    match /students/{studentId} {
      allow read: if true;
      allow create: if isValidStudent(incoming()) && studentId.size() <= 128;
      allow update: if isValidStudent(incoming());
      allow delete: if true;
    }

    match /loans/{loanId} {
      allow read: if true;
      allow create: if isValidLoan(incoming()) && loanId.size() <= 128;
      allow update: if isValidLoan(incoming());
      allow delete: if true;
    }
  }
}
