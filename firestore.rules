rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Book Validation
    function isValidBook(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.author is string && data.author.size() > 0 && data.author.size() <= 200 &&
             data.status in ['available', 'loaned', 'damaged', 'lost'];
    }

    // Student Validation
    function isValidStudent(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.studentId is string && data.studentId.size() > 0;
    }

    // Loan Validation
    function isValidLoan(data) {
      return data.bookId is string && isValidId(data.bookId) &&
             data.studentId is string && isValidId(data.studentId) &&
             data.loanDate is timestamp &&
             data.dueDate is timestamp &&
             data.status in ['active', 'returned', 'overdue'];
    }

    match /books/{bookId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidBook(incoming()) && isValidId(bookId);
      allow update: if isSignedIn() && isValidBook(incoming());
      allow delete: if isSignedIn();
    }

    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidStudent(incoming()) && isValidId(studentId);
      allow update: if isSignedIn() && isValidStudent(incoming());
      allow delete: if isSignedIn();
    }

    match /loans/{loanId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidLoan(incoming()) && isValidId(loanId);
      allow update: if isSignedIn() && isValidLoan(incoming());
      allow delete: if isSignedIn();
    }
  }
}
